load(":defs.bzl", "wasm32_build", "wasm32_probe_build")

# Evaluation of a browser build (WASM + WebGPU); owned by the wasm-eval agent.

platform(
    name = "wasm32",
    constraint_values = [
        "@platforms//cpu:wasm32",
        "@platforms//os:none",
    ],
)

# Compile checks: each crate of the GLFW app's render path, built as an rlib
# for wasm32-unknown-unknown. One target per crate, so a failure in one does
# not hide the others (build with --keep_going).
WASM_CHECK_CRATES = {
    "mln_math": "//crates/mln_math",
    "mln_util": "//crates/mln_util",
    "mln_tile_id": "//crates/mln_tile_id",
    "mln_style_types": "//crates/mln_style_types",
    "mln_conversion": "//crates/mln_conversion",
    "mln_actor": "//crates/mln_actor",
    "mln_tile": "//crates/mln_tile",
    "mln_expression": "//crates/mln_expression",
    "mln_text": "//crates/mln_text",
    "mln_platform_default_image": "//crates/mln_platform_default_image",
    "mln_storage": "//crates/mln_storage",
    "mln_sprite": "//crates/mln_sprite",
    "mln_style": "//crates/mln_style",
    "mln_map_types": "//crates/mln_map_types",
    "mln_gfx": "//crates/mln_gfx",
    "mln_webgpu": "//crates/mln_webgpu",
    "mln_renderer": "//crates/mln_renderer",
    "mln_map": "//crates/mln_map",
}

[
    wasm32_build(
        name = "check_" + name,
        deps = [label],
    )
    for name, label in WASM_CHECK_CRATES.items()
]

# Third-party crates, checked one by one.
WASM_CHECK_THIRD_PARTY = [
    "bytemuck",
    "flate2",
    "harfrust",
    "image-webp",
    "mlt-core",
    "png",
    "pollster",
    "rusqlite",
    "serde_json",
    "skrifa",
    "unicode-bidi",
    "ureq",
    "wgpu",
]

[
    wasm32_build(
        name = "check_crate_" + name,
        deps = ["@next_crates//:" + name],
    )
    for name in WASM_CHECK_THIRD_PARTY
]

# The same checks through the probe transition (local wasm32 C compiler for
# build scripts, compile-only getrandom backends): how far the unmodified
# crates get once the toolchain gaps are closed.
[
    wasm32_probe_build(
        name = "probe_" + name,
        deps = [label],
    )
    for name, label in WASM_CHECK_CRATES.items()
]

[
    wasm32_probe_build(
        name = "probe_crate_" + name,
        deps = ["@next_crates//:" + name],
    )
    for name in WASM_CHECK_THIRD_PARTY
]
