load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_rust//rust:defs.bzl", "rust_test")

# The C++ standard library parts of render-test's Manifest::doShuffle; no
# mbgl-core needed.
cc_library(
    name = "reference",
    srcs = ["reference.cpp"],
    copts = ["-std=c++20"],
)

rust_test(
    name = "render_test_difftest",
    srcs = ["render_test_difftest.rs"],
    deps = [
        ":reference",
        "//tools/render-test:render_test",
        "@next_crates//:proptest",
    ],
)
