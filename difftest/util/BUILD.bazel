load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Differential tests: //crates/mln_math, //crates/mln_util,
# //vendor/csscolorparser and //vendor/rapidjson against the C++ core.

cc_library(
    name = "reference",
    srcs = ["reference.cpp"],
    copts = ["-std=c++20"],
    # The tests link only what these util functions need from mbgl-core;
    # without section GC the C++ link (experimental_use_cc_common_link)
    # reports the platform symbols (LayerManager, RunLoop, ...) that unused
    # code in the pulled-in objects references.
    linkopts = ["-Wl,--gc-sections"],
    deps = ["@maplibre//:mbgl-core"],
)

# Safe Rust wrappers around :reference, shared by the tests.
rust_library(
    name = "reference_ffi",
    srcs = ["reference_ffi.rs"],
    link_deps = [":reference"],
)

[
    rust_test(
        name = name,
        size = "medium",
        srcs = [name + ".rs"],
        deps = [
            ":reference_ffi",
            "//crates/mln_math",
            "//crates/mln_util",
            "//vendor/csscolorparser",
            "//vendor/maplibre-native-base:maplibre_native_base",
            "//vendor/rapidjson",
            "@next_crates//:proptest",
        ],
    )
    for name in [
        "math_difftest",
        "cstdlib_difftest",
        "csscolorparser_difftest",
        "color_difftest",
        "string_difftest",
        "geo_difftest",
    ]
]
