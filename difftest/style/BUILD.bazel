load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_rust//rust:defs.bzl", "rust_test")

# Differential tests: //crates/mln_style against the C++ core (style parser,
# background-layer paint properties, transitions).

cc_library(
    name = "reference",
    srcs = [
        "platform_shims.cpp",
        "reference.cpp",
    ],
    copts = [
        "-std=c++20",
        "-fexceptions",
        "-fno-rtti",
        "-Wno-deprecated-declarations",
    ],
    # platform_shims.cpp defines symbols that mbgl-core needs; linked as a whole
    # archive they resolve regardless of archive order (C++ link action).
    alwayslink = True,
    deps = ["@maplibre//:mbgl-core"],
)

rust_test(
    name = "style_difftest",
    size = "medium",
    srcs = ["style_difftest.rs"],
    data = ["@maplibre//metrics:render-test-files"],
    deps = [
        ":reference",
        "//crates/mln_style",
        "//crates/mln_style_types",
        "//crates/mln_util",
        "@next_crates//:proptest",
    ],
)
