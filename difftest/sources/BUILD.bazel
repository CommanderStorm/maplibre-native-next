load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_rust//rust:defs.bzl", "rust_test")

# Differential tests: the GeoJSON source (mln_style::sources) and the tile
# pipeline (mln_renderer: TilePyramid, GeoJSONTileData) against the C++
# core.

# The oracle as a C++ executable (the thread pool and the Linux platform,
# mbgl-default + platform/linux, link completely only into C++ executables);
# sources_difftest.rs drives it over stdin/stdout.
cc_binary(
    name = "sources_oracle",
    srcs = ["oracle_main.cpp"],
    # mbgl-core is built without RTTI; FakeTile derives from its classes.
    copts = [
        "-std=c++20",
        "-fexceptions",
        "-fno-rtti",
    ],
    # Dynamic mode, as cc_test links the C++ test binaries: mbgl-core and
    # mbgl-default reference each other.
    linkstatic = False,
    deps = [
        "@maplibre//:mbgl-core",
        "@maplibre//platform/default:mbgl-default",
        "@maplibre//platform/linux:impl",
    ],
)

rust_test(
    name = "sources_difftest",
    size = "medium",
    srcs = ["sources_difftest.rs"],
    data = [
        ":sources_oracle",
        "@maplibre//metrics:render-test-files",
    ],
    deps = [
        "//crates/mln_actor",
        "//crates/mln_conversion",
        "//crates/mln_map",
        "//crates/mln_map_types",
        "//crates/mln_renderer",
        "//crates/mln_style",
        "//crates/mln_tile_id",
        "//crates/mln_util",
        "//vendor/maplibre-native-base:maplibre_native_base",
        "@next_crates//:serde_json",
    ],
)
