load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@rules_rust//rust:defs.bzl", "rust_static_library")

# maplibre-native-ffi's C API (https://github.com/maplibre/maplibre-native-ffi)
# on the Rust port: a static library that stands in for the ffi's C++
# `maplibre_native_c` library. Owned by the ffi-eval agent.

# The ffi's public headers, copied unchanged from maplibre-native-ffi
# 2c580a4 (include/), plus upstream's include/mln/plugin/plugin_api.h, which
# plugin.h includes.
cc_library(
    name = "headers",
    hdrs = glob(["include/**/*.h"]),
    includes = ["include"],
    visibility = ["//visibility:public"],
)

rust_static_library(
    name = "maplibre_native_c",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "maplibre_native_c",
    visibility = ["//visibility:public"],
    deps = [
        "//crates/mln_actor",
        "//crates/mln_gfx",
        "//crates/mln_map",
        "//crates/mln_platform_default",
        "//crates/mln_renderer",
        "//crates/mln_storage",
        "//crates/mln_util",
    ],
)

# The C API from C, through the ffi's header: struct layouts against the
# Rust mirrors, a static map's still image and a continuous map's frame
# demands rendered offscreen (lavapipe) and read back.
cc_test(
    name = "c_api_test",
    srcs = ["tests/c_api_test.c"],
    copts = ["-std=c23"],
    deps = [
        ":headers",
        ":maplibre_native_c",
    ],
)
