load("@rules_cc//cc:defs.bzl", "cc_library")

# The system GLFW (on NixOS: the #linux dev shell's glfw), for the glfw-sys
# crate, whose build script would otherwise need pkg-config inside the build
# sandbox. This is all that build script emits for `dynamic-link` on Linux.
cc_library(
    name = "system",
    linkopts = ["-lglfw"],
    visibility = ["//visibility:public"],
)
