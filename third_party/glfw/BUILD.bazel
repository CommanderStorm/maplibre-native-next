load("@rules_cc//cc:defs.bzl", "cc_library")

# The system GLFW (on NixOS: the #linux dev shell's glfw; on macOS:
# Homebrew's), for the glfw-sys crate, whose build script would otherwise
# need pkg-config inside the build sandbox. This is all that build script
# emits for `dynamic-link` on Linux.
cc_library(
    name = "system",
    linkopts = select({
        # Homebrew's lib dir is not on the default search path.
        "@platforms//os:macos": [
            "-L/opt/homebrew/lib",
            "-lglfw",
        ],
        "//conditions:default": ["-lglfw"],
    }),
    visibility = ["//visibility:public"],
)
