#!/usr/bin/env bash
# Vendors the C++ core's WGSL shaders: extracts them, unchanged, from
# include/mln/shaders/webgpu/*.hpp of a maplibre-native checkout (default:
# ../maplibre-native) into crates/mln_webgpu/src/shaders/wgsl_sources.rs.
# Rerun it when the C++ shaders change, and commit the result.
#
# Usage: scripts/vendor-shaders [maplibre-native checkout]
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cpp="${1:-$root/../maplibre-native}"

shopt -s nullglob
headers=("$cpp"/include/mln/shaders/webgpu/*.hpp)
if [[ ${#headers[@]} -eq 0 ]]; then
    echo "no WGSL headers in $cpp/include/mln/shaders/webgpu" >&2
    exit 1
fi

tool_dir="$(mktemp -d)"
trap 'rm -rf "$tool_dir"' EXIT
rustc --edition 2024 -O -o "$tool_dir/extract_wgsl" "$root/crates/mln_webgpu/tools/extract_wgsl.rs"
"$tool_dir/extract_wgsl" "$root/crates/mln_webgpu/src/shaders/wgsl_sources.rs" "${headers[@]}"
echo "vendored ${#headers[@]} headers from $cpp ($(git -C "$cpp" describe --always --dirty 2>/dev/null || echo "not a git checkout"))"
