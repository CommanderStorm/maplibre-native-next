#!/usr/bin/env bash
# Runs Bazel on NixOS inside the C++ repo's #linux dev shell (clang 20, zlib,
# icu, ...) with bazelisk from nixpkgs.
#
# Every local Bazel invocation goes through this script so that each one sees
# the same environment. A changed environment makes the shared Bazel server
# reconfigure the C++ toolchain and rebuild the C++ core.
#
# The flake is used from a copy: `nix develop path:<repo>` would copy the whole
# C++ working tree into the store on every call.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cpp="$(cd "$root/../maplibre-native" && pwd)"
shell_dir="$root/.nix-shell"

mkdir -p "$shell_dir"
for f in flake.nix flake.lock; do
    cmp -s "$cpp/$f" "$shell_dir/$f" || cp "$cpp/$f" "$shell_dir/$f"
done

cd "$root"
exec nix develop "path:$shell_dir#linux" --command \
    nix shell nixpkgs#bazelisk --command bazelisk "$@"
