+    /// HarfBuzz's `font->x_scale` / `y_scale`: the configured scale, or
+    /// `upem` (the default scale of a HarfBuzz font) when none is set.
+    pub(crate) fn font_scale(&self, upem: i32) -> (i32, i32) {
+        self.scale.unwrap_or((upem, upem))
+    }
+
+    /// HarfBuzz's `roundf`, which rounds ties towards +infinity
+    /// (hb-algs.hh: `floor (x + .5)`); `f32::round` rounds them away from
+    /// zero, which differs for negative halves.
+    #[inline(always)]
+    fn hb_roundf(x: f32) -> i32 {
+        (x + 0.5).floor() as i32
+    }
