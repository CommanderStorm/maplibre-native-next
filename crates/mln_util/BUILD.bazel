load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Ports src/mln/util + include/mln/util (the files that do not depend on
# higher modules; see PLAN.md, "Crate map").
rust_library(
    name = "mln_util",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
    deps = [
        "//crates/mln_math",
        "//vendor/csscolorparser",
        "//vendor/maplibre-native-base:maplibre_native_base",
        "//vendor/rapidjson",
    ],
)

rust_test(
    name = "mln_util_test",
    crate = ":mln_util",
)
