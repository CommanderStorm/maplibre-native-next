load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Ports platform/default/src/mln/util/{image,png_reader,png_writer}.cpp
# (decodeImage, encodePNG) and the compress() they use from compression.cpp.
# Kept out of mln_util so that crate needs no image codec dependencies.
rust_library(
    name = "mln_platform_default_image",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
    deps = [
        "//crates/mln_util",
        "@next_crates//:flate2",
        "@next_crates//:png",
    ],
)

rust_test(
    name = "mln_platform_default_image_test",
    crate = ":mln_platform_default_image",
    data = [
        "@maplibre//metrics:render-test-files",
        "@maplibre//test:fixtures",
    ],
)
