load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load(":wgsl_sources.bzl", "wgsl_sources")

# The C++ headers holding the WGSL sources (include/mln/shaders/webgpu/*.hpp).
WGSL_HEADERS = ["@maplibre//:webgpu-shader-headers"]

# Extracts the WGSL raw string literals from the C++ headers, unchanged.
rust_binary(
    name = "extract_wgsl",
    srcs = ["tools/extract_wgsl.rs"],
)

wgsl_sources(
    name = "wgsl_sources",
    srcs = WGSL_HEADERS,
    out = "src/shaders/wgsl_sources.rs",
    tool = ":extract_wgsl",
)

# Ports src/mln/webgpu, include/mln/webgpu, include/mln/shaders/webgpu,
# src/mln/shaders/webgpu and the WebGPU headless backend (platform/default).
rust_library(
    name = "mln_webgpu",
    srcs = glob(["src/**/*.rs"]) + [":wgsl_sources"],
    visibility = ["//visibility:public"],
    deps = [
        "//crates/mln_gfx",
        "//crates/mln_tile_id",
        "//crates/mln_util",
        "@next_crates//:bytemuck",
        "@next_crates//:pollster",
        "@next_crates//:wgpu",
    ],
)

rust_test(
    name = "mln_webgpu_test",
    crate = ":mln_webgpu",
)

# Headless wgpu smoke test: Vulkan (lavapipe) device, offscreen clear and
# readback. user.bazelrc passes LD_LIBRARY_PATH and VK_DRIVER_FILES.
rust_test(
    name = "smoke_test",
    srcs = ["tests/smoke_test.rs"],
    deps = [
        "@next_crates//:pollster",
        "@next_crates//:wgpu",
    ],
)

# The background shader end to end on the drawable path: HeadlessBackend,
# BackgroundShader from the registry, a DrawableBuilder drawable in a
# TileLayerGroup with the UBOs background_layer_tweaker.cpp sets, rendered
# into the offscreen target and read back.
rust_test(
    name = "background_test",
    srcs = ["tests/background_test.rs"],
    deps = [
        ":mln_webgpu",
        "//crates/mln_gfx",
        "//crates/mln_tile_id",
        "//crates/mln_util",
        "@next_crates//:bytemuck",
    ],
)

# Ports test/renderer/wgsl_preprocessor.test.cpp
rust_test(
    name = "shader_group_preprocessor_test",
    srcs = ["tests/shader_group_preprocessor.rs"],
    deps = [":mln_webgpu"],
)

# Compiles all extracted WGSL with wgpu (naga); the M1 shaders must compile.
rust_test(
    name = "wgsl_compile_test",
    srcs = ["tests/wgsl_compile_test.rs"],
    deps = [
        ":mln_webgpu",
        "//crates/mln_gfx",
        "//crates/mln_util",
    ],
)
