load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Ports the tile data side of src/mln/tile (vector_mvt_tile_data.cpp,
# geometry_tile_data.cpp). A low crate: no style/renderer/expression deps.
rust_library(
    name = "mln_tile",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
    deps = [
        "//crates/mln_tile_id",
        "//crates/mln_util",
        "//vendor/maplibre-native-base:maplibre_native_base",
        "//vendor/protozero",
        "//vendor/vector-tile:vector_tile",
        "//vendor/wagyu",
    ],
)

# Ports test/tile/geometry_tile_data.test.cpp and test/tile/vector_tile.test.cpp.
rust_test(
    name = "mln_tile_test",
    crate = ":mln_tile",
    data = ["@maplibre//test:fixtures"],
)
