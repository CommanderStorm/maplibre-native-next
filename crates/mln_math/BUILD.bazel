load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Ports include/mln/math.
rust_library(
    name = "mln_math",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
)

rust_test(
    name = "mln_math_test",
    crate = ":mln_math",
)

# Ported C++ gtests (test/math); markers `// gtest: Group.Name`.
rust_test(
    name = "mln_math_gtest",
    srcs = ["tests/gtest_math.rs"],
    deps = [":mln_math"],
)
