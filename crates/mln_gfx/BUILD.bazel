load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Ports include/mln/gfx, src/mln/gfx, the backend-independent parts of
# include/mln/shaders + src/mln/shaders, and the renderer files the backends
# implement (renderer/layer_group, renderer/render_pass). See src/lib.rs.
rust_library(
    name = "mln_gfx",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
    deps = [
        "//crates/mln_style_types",
        "//crates/mln_tile_id",
        "//crates/mln_util",
        "//vendor/maplibre-native-base:maplibre_native_base",
        "@next_crates//:bytemuck",
    ],
)

rust_test(
    name = "mln_gfx_test",
    crate = ":mln_gfx",
)

# Ports test/renderer/shader_registry.test.cpp
rust_test(
    name = "shader_registry_test",
    srcs = ["tests/shader_registry.rs"],
    deps = [
        ":mln_gfx",
        "//crates/mln_util",
    ],
)
