load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Ports src/mln/actor and util/{run_loop,async_task,thread,thread_pool} with
# the platform/default loop.
rust_library(
    name = "mln_actor",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
    deps = ["//crates/mln_util"],
)

rust_test(
    name = "mln_actor_test",
    crate = ":mln_actor",
)
