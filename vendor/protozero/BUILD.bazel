load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Ports the reader half of ../maplibre-native/vendor/protozero (1.7.1):
# pbf_reader, varint/zigzag decoding, the packed-field iterators, data_view
# and the exceptions. The C++ core uses only these (vector-tile, glyph PBFs).
rust_library(
    name = "protozero",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
)

rust_test(
    name = "protozero_test",
    crate = ":protozero",
)
