load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Ports the vendored nunicode subset of the C++ core
# (../maplibre-native/vendor/nunicode, config.h: UTF-8, toupper, tolower,
# unaccent, 0-terminated collation): DUCET collation, case mapping and
# unaccent, used by the default platform collator and string case mapping.
rust_library(
    name = "nunicode",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
)

rust_test(
    name = "nunicode_test",
    crate = ":nunicode",
)
