load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Ports vendor/kdbush.hpp (header-only kdbush.hpp).
rust_library(
    name = "kdbush",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
    deps = ["//vendor/libstdcxx"],
)

rust_test(
    name = "kdbush_test",
    crate = ":kdbush",
)

# Port of kdbush.hpp/test.cpp; its points and expected ids are read from
# that file in place.
rust_test(
    name = "kdbush_source_test",
    srcs = ["tests/kdbush.rs"],
    data = ["@maplibre//vendor:kdbush_test_source"],
    deps = [":kdbush"],
)
