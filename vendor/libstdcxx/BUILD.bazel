load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Ports the libstdc++ (GCC 16) algorithms whose results the vendored geometry
# libraries depend on: std::sort, std::stable_sort, the heap functions and
# std::priority_queue (bits/stl_algo.h, bits/stl_heap.h, bits/stl_queue.h).
rust_library(
    name = "libstdcxx",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
)

rust_test(
    name = "libstdcxx_test",
    crate = ":libstdcxx",
)
