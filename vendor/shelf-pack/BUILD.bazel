load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Ports vendor/maplibre-native-base/deps/shelf-pack-cpp (header-only
# mapbox/shelf-pack.hpp).
rust_library(
    name = "shelf_pack",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
)

rust_test(
    name = "shelf_pack_test",
    crate = ":shelf_pack",
)

# Port of shelf-pack-cpp/test/test.cpp (no fixtures).
rust_test(
    name = "shelf_pack_unit_test",
    srcs = ["tests/shelf_pack.rs"],
    deps = [":shelf_pack"],
)
