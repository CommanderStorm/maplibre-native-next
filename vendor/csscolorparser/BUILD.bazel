load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Ports vendor/csscolorparser (csscolorparser.cpp + csscolorparser.hpp), plus
# the glibc strtof/strtod/strtoll semantics it relies on (src/cstdlib.rs).
#
# Not the crates.io `csscolorparser` crate (@next_crates//:csscolorparser),
# which accepts different input. Both have the crate name `csscolorparser`;
# nothing depends on the crates.io one any more.
rust_library(
    name = "csscolorparser",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
)

rust_test(
    name = "csscolorparser_test",
    crate = ":csscolorparser",
)
