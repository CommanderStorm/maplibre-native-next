load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Ports the number formatting of vendor/rapidjson
# (include/rapidjson/internal/{ieee754,diyfp,dtoa,itoa}.h) and the compact
# `Writer<StringBuffer>` (include/rapidjson/writer.h). JSON parsing is
# serde_json (see //crates/mln_conversion).
rust_library(
    name = "rapidjson",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
)

rust_test(
    name = "rapidjson_test",
    crate = ":rapidjson",
)
