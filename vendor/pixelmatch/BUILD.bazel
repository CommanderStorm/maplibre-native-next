load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Ports vendor/maplibre-native-base/deps/pixelmatch-cpp (header-only
# mapbox/pixelmatch.hpp), the image diff metric of the render-test runner.
rust_library(
    name = "pixelmatch",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
)

rust_test(
    name = "pixelmatch_test",
    crate = ":pixelmatch",
)

# Port of pixelmatch-cpp/test/test.cpp over its fixtures, read in place.
rust_test(
    name = "pixelmatch_fixtures_test",
    srcs = ["tests/fixtures.rs"],
    data = ["@maplibre//vendor:pixelmatch_fixtures"],
    deps = [":pixelmatch"],
)
