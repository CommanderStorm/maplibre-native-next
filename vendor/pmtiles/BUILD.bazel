load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Ports the reading half of vendor/PMTiles/cpp/pmtiles.hpp (header and
# directory decoding, tile ids, directory search), as the PMTiles file source
# uses it.
rust_library(
    name = "pmtiles",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
)

rust_test(
    name = "pmtiles_test",
    crate = ":pmtiles",
)
